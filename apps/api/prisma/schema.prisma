generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PILOT
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum ZoneType {
  RED
  YELLOW
  GREEN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          Role      @default(PILOT)
  exp           Int       @default(0)
  phone         String?
  emailVerified Boolean   @default(false)
  otpHash       String?
  otpExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  violations    Violation[]
  progresses    LessonProgress[]
  certificates  Certificate[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  type        ZoneType
  description String?
  polygon     Json
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model Course {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons      Lesson[]
  certificates Certificate[]
}

model Lesson {
  id             String   @id @default(uuid())
  courseId       String
  title          String
  content        String
  videoUrl       String?
  position       Int
  minReadSeconds Int      @default(60)
  createdAt      DateTime @default(now())

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses LessonProgress[]

  @@unique([courseId, position])
}

model LessonProgress {
  id           String    @id @default(uuid())
  userId       String
  lessonId     String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  secondsSpent Int       @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Violation {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Certificate {
  id       String   @id @default(uuid())
  userId   String
  courseId String
  code     String   @unique
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([code])
}
